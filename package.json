{
  "name": "dsh-safety",
  "version": "0.1.0",
  "description": "A safety harness plugin for DeepSeek Harness (DSH): protected-path enforcement, trash-based safe_delete with undo, last-known-good composition snapshots, pre-restart composition checks, and an audit journal.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-safety": "./bin/dsh-safety.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "bin/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/safety.test.mjs",
    "test:harness": "node test/harness.mjs",
    "check": "node --check lib/index.js && node --check lib/safety-core.mjs && node --check lib/client.js && node --check bin/dsh-safety.mjs",
    "prepublishOnly": "npm run check && npm test",
    "pack": "npm pack --dry-run"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "safety",
    "security",
    "backup",
    "trash",
    "guard"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_NAME/dsh-safety.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_NAME/dsh-safety/issues"
  },
  "homepage": "https://github.com/YOUR_NAME/dsh-safety#readme"
}
